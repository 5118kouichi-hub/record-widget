<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: only LinearLayout / FrameLayout / ImageView / ImageButton / TextView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Disc and tonearm share one box and the same 100x100 vector viewport, so with
         fitCenter the arm always lines up with the disc at any widget size. -->
    <FrameLayout
        android:id="@+id/disc_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/cd_disc_stopped">

        <ImageView
            android:id="@+id/disc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/record_disc" />

        <ImageView
            android:id="@+id/tonearm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/tonearm_up" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_next"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next" />
    </LinearLayout>
</LinearLayout>

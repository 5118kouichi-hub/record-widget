            android:layout_width="26.0dp"
            android:layout_height="26.0dp"
            android:layout_gravity="left|top"
            android:layout_marginLeft="18.0dp"
            android:layout_marginTop="167.0dp"
            android:background="@drawable/player_key"
            android:contentDescription="@string/cd_prev"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/next"
            android:layout_width="26.0dp"
            android:layout_height="26.0dp"
            android:layout_gravity="left|top"
            android:layout_marginLeft="50.0dp"
            android:layout_marginTop="167.0dp"
            android:background="@drawable/player_key"
            android:contentDescription="@string/cd_next"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next" />

        <!-- Title printed on the red front of the case. -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="24.0dp"
            android:layout_gravity="left|top"
            android:layout_marginTop="196.0dp"
            
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFF3E0"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>

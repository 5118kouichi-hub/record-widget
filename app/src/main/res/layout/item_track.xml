<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@color/shop_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/rename_title"
        android:drawableEnd="@drawable/ic_edit_hint"
        android:drawablePadding="8dp"
        android:textColor="@color/shop_text"
        android:textSize="16sp" />

    <Button
        android:id="@+id/upButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:minWidth="0dp"
        android:contentDescription="@string/move_up"
        android:text="▲"
        android:textColor="@color/shop_text" />

    <Button
        android:id="@+id/downButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:minWidth="0dp"
        android:contentDescription="@string/move_down"
        android:text="▼"
        android:textColor="@color/shop_text" />

    <Button
        android:id="@+id/deleteButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="0dp"
        android:text="@string/delete"
        android:textColor="@color/shop_accent" />
</LinearLayout>

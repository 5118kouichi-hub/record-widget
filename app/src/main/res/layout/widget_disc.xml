<?xml version="1.0" encoding="utf-8"?>
<!-- Square record box. Included with a fixed square size so the spinner is never squashed.
     All layers share record_disc's 100x100 viewport, so they line up at any size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Paused: still record. -->
    <ImageView
        android:id="@+id/disc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/record_disc" />

    <!-- Playing: the same record, turning (33 1/3 rpm = 1.8 s per turn). -->
    <ProgressBar
        android:id="@+id/disc_spin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/record_spin"
        android:indeterminateDuration="1800"
        android:indeterminateOnly="true"
        android:maxWidth="1000dp"
        android:maxHeight="1000dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:visibility="gone" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/record_sheen" />

    <ImageView
        android:id="@+id/tonearm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/tonearm_up" />
</FrameLayout>

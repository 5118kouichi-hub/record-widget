<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base: used by overlay views (ContextThemeWrapper) and as the manifest theme. -->
    <style name="Theme.RecordWidget" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/retro_red</item>
        <item name="colorPrimaryDark">@color/retro_wood</item>
        <item name="colorAccent">@color/retro_red</item>
        <item name="android:windowBackground">@color/retro_wood</item>
        <item name="android:textColorPrimary">@color/retro_ink</item>
        <item name="android:textColorSecondary">@color/retro_ink_sub</item>
    </style>

    <!-- The app screen: retro listening room (see UiStyle). -->
    <style name="Theme.RecordWidget.Retro" parent="Theme.RecordWidget">
        <item name="alertDialogTheme">@style/ThemeOverlay.RecordWidget.Dialog</item>
    </style>

    <!-- Dialogs: a cream card with red buttons. -->
    <style name="ThemeOverlay.RecordWidget.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorAccent">@color/retro_red</item>
        <item name="android:textColorPrimary">@color/retro_ink</item>
        <item name="android:textColorSecondary">@color/retro_ink_sub</item>
    </style>
</resources>
